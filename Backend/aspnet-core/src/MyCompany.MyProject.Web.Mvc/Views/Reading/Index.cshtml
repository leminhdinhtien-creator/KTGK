@{
    Layout = null;
}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TOEIC Reading • Quản lý đề</title>
<link rel="stylesheet" href="/css/reading-studio-v2.css"><style>
:root{font-family:Segoe UI,Arial,sans-serif;color:#172c40;background:#f3f6fa}*{box-sizing:border-box}body{margin:0}header{padding:28px 5%;background:#133b53;color:white;display:flex;justify-content:space-between;align-items:center}main{max-width:1200px;margin:32px auto;padding:0 24px}.grid{display:grid;grid-template-columns:300px 1fr;gap:24px}.card{background:white;border:1px solid #dce4eb;border-radius:18px;padding:24px;margin-bottom:20px}h1{font-size:25px;margin:0}h2{font-size:20px}p{line-height:1.65}.muted{color:#617184}.badge{display:inline-block;color:#087f78;background:#e4f4ef;border-radius:20px;padding:7px 12px;font-size:13px}button{background:#087f78;color:white;border:0;border-radius:10px;padding:13px 18px;cursor:pointer;font:inherit}button.secondary{background:#edf2f6;color:#173b53}button:disabled{opacity:.5}input,textarea,select{font:inherit;border:1px solid #ccd7df;border-radius:9px;width:100%;padding:10px;margin:7px 0}textarea{min-height:100px}img{max-width:100%;border:1px solid #e0e5eb}details{border-top:1px solid #dae1e8;padding:16px 0}summary{cursor:pointer;font-weight:600}#message{white-space:pre-wrap;padding:12px;border-radius:10px}a{color:inherit}label{display:block;font-size:14px;margin-top:12px}.exam{display:block;width:100%;text-align:left;margin-top:12px}.questions{display:flex;gap:5px;flex-wrap:wrap}.questions button{padding:8px}@@media(max-width:800px){.grid{grid-template-columns:1fr}header{padding:22px}main{padding:0 14px}}

:root{font-family:'DM Sans',Segoe UI,sans-serif;color:var(--v2-ink);background:var(--v2-paper)}body{background:var(--v2-paper)}header{background:white;color:var(--v2-ink);border-bottom:1px solid var(--v2-line);padding:24px 5%}header h1{font-family:'Playfair Display',serif;font-size:30px}main{max-width:1340px}.grid{grid-template-columns:300px minmax(0,1fr);gap:28px}.card{border-color:var(--v2-line);box-shadow:0 12px 32px #142d3208}.card h2{font-family:'Playfair Display',serif;font-size:25px}.badge{background:var(--v2-sage);color:var(--v2-green)}button{min-height:48px;background:var(--v2-green);font-weight:600}button.secondary{background:var(--v2-sage);color:var(--v2-green)}button:hover{filter:brightness(.96)}button:focus-visible,summary:focus-visible{outline:3px solid #087f6940;outline-offset:3px}.muted{color:var(--v2-ink-2)}details{border:1px solid var(--v2-line);border-radius:12px;padding:16px;margin:12px 0;background:white}summary{line-height:1.6}details[open]{background:#f9faf8}input,textarea,select{min-height:48px;border-color:var(--v2-line-dark)}input[type=checkbox]{min-height:0}.part-nav{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.part-nav button{background:white;color:var(--v2-ink);border:1px solid var(--v2-line)}.part-nav button.active{background:var(--v2-green);color:white}.import-steps{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}.import-steps span{padding:10px 16px;border-radius:10px;background:var(--v2-sage);color:var(--v2-green);font-size:13px}form button{width:100%;margin-top:10px}#message:empty{display:none}#message{margin-bottom:16px;border:1px solid var(--v2-line);line-height:1.6}@@media(max-width:800px){.grid{grid-template-columns:1fr}.card{padding:20px}header{padding:20px}header a{font-size:12px}}
</style></head><body><header><div><div style="letter-spacing:3px;font-size:12px;margin-bottom:8px">READING STUDIO</div><h1>Quản lý đề TOEIC</h1></div><a href="/" target="_top">Trang chung Admin / User</a></header><main><div class="import-steps" aria-label="Các bước nhập đề"><span>1 · Chọn file Word</span><span>2 · Xem trước & kiểm tra</span><span>3 · Import đề hợp lệ</span></div><div class="grid"><aside><section class="card"><span class="badge">QUẢN LÝ NỘI DUNG</span><h2>Thêm đề thi mới</h2><p class="muted">100 câu · Part 5, 6, 7 · 75 phút</p><form id="upload">@Html.AntiForgeryToken()<label for="file">Chọn đề thi có Tags chuẩn (.docx)</label><input type="file" id="file" accept=".docx" required><button type="button" class="secondary" onclick="previewFile()">Xem trước file Word</button><button type="submit">Import đề thi</button></form><p class="muted">Chỉ lưu khi toàn bộ cấu trúc hợp lệ.</p></section><section class="card"><h2>Thư viện đề</h2><input type="search" id="exam-search" placeholder="Tìm tên đề..." aria-label="Tìm đề đã import"><div id="list"></div></section></aside><section><div id="message" role="status"></div><div id="preview" class="card"><span class="badge">XEM TRƯỚC & BIÊN TẬP</span><h2>Chọn đề để rà soát</h2><p class="muted">Chọn đề bên trái để xem bài đọc, câu hỏi, đáp án và chỉnh sửa.</p></div></section></div></main>
<script>
const $=id=>document.getElementById(id);let exam;let adminPart=5;let library=[];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function call(url,options={}){const token=document.querySelector('[name=__RequestVerificationToken]').value;const r=await fetch(url,{...options,headers:{'RequestVerificationToken':token,'X-XSRF-TOKEN':token,...options.headers}});const raw=await r.text();let j;try{j=raw?JSON.parse(raw):null}catch{throw Error('Phiên đăng nhập hết hạn hoặc máy chủ chưa sẵn sàng.')}if(!r.ok||j?.success===false)throw Error(j?.error?.message||'Không thể hoàn tất yêu cầu.');return j?.result??j}
function message(s,error=false){$('message').textContent=s;$('message').style.background=error?'#ffeded':'#e5f5ef'}
function renderLibrary(){const query=$('exam-search').value.toLowerCase();const list=library.filter(e=>e.name.toLowerCase().includes(query));$('list').innerHTML=list.length?list.map(e=>`<button class="exam secondary" data-id="${e.id}">${esc(e.name)}<br><small>${e.totalQuestions} câu · ${e.durationMinutes} phút</small></button>`).join(''):'<p class="muted">Không có đề phù hợp.</p>';$('list').querySelectorAll('button').forEach(b=>b.onclick=()=>loadExamPreview(b.dataset.id))}
async function load(){try{library=await call('/Reading/Exams');renderLibrary()}catch(e){message(e.message,true)}}
$('exam-search').oninput=renderLibrary;
async function loadExamPreview(id){try{exam=await call('/Reading/Preview?id='+id);render()}catch(e){message(e.message,true)}}
function questionMarkup(q){return `<details id="q-${q.number}"><summary>Câu ${q.number} · Đáp án ${esc(q.correctAnswer)}</summary><label>Nội dung<textarea id="stem-${q.number}">${esc(q.text)}</textarea></label>${q.options.map(o=>`<label>${o.letter}<input id="opt-${q.number}-${o.letter}" value="${esc(o.text)}"></label>`).join('')}<label>Đáp án<select id="answer-${q.number}">${'ABCD'.split('').map(a=>`<option ${a===q.correctAnswer?'selected':''}>${a}</option>`).join('')}</select></label><label>Trạng thái<select id="status-${q.number}"><option value="proposed" ${q.answerStatus==='proposed'?'selected':''}>Đề xuất</option><option value="verified" ${q.answerStatus==='verified'?'selected':''}>Đã xác minh</option></select></label><button ${exam.id ? "" : "disabled"} onclick="saveQuestion(${q.number})">Lưu câu hỏi</button></details>`}
function documentMarkup(d){const source=d.imageUrl||`data:${d.imageMime};base64,${d.image}`;const image=d.image||d.imageUrl?`<img src="${esc(source)}" alt="Bài đọc gốc">`:'';return `<details><summary>Tài liệu ${d.order}</summary>${image}<label>Văn bản<textarea id="doc-${d.id}">${esc(d.text)}</textarea></label><label>Thay ảnh PNG/JPEG<input type="file" id="img-${d.id}" accept="image/png,image/jpeg"></label><label><input type="checkbox" id="remove-${d.id}" style="width:auto"> Xóa ảnh để hiển thị văn bản đã sửa</label><button ${exam.id?'':'disabled'} onclick="saveDoc(${d.id})">Lưu tài liệu</button></details>`}
function render(){let h=`<span class="badge">${exam.totalQuestions} CÂU · ${exam.durationMinutes} PHÚT</span><h2>${esc(exam.name)}</h2><p class="muted">Đáp án: ${exam.answerStatus==='verified'?'đã xác minh':'đề xuất, chưa phải đáp án ETS chính thức'}. Đề có lượt thi sẽ được khóa chỉnh sửa để bảo toàn kết quả.</p><nav class="part-nav" aria-label="Chọn phần đề thi">${exam.parts.map(p=>`<button class="${p.number===adminPart?'active':''}" onclick="selectPart(${p.number})">Part ${p.number} · ${p.questions.length} câu</button>`).join('')}</nav>`;for(const p of exam.parts.filter(p=>p.number===adminPart)){h+=`<h2>Part ${p.number}</h2>`;for(const g of p.groups){const questions=p.questions.filter(q=>q.groupKey?q.groupKey===g.key:q.groupId===g.id);h+=`<section><h3>Nhóm ${esc(g.key)}</h3><p class="muted">${g.documents.length} tài liệu · ${questions.length} câu hỏi</p>${g.documents.map(documentMarkup).join('')}${questions.map(questionMarkup).join('')}</section>`}h+=p.questions.filter(q=>q.groupId==null&&!q.groupKey).map(questionMarkup).join('')}$('preview').innerHTML=h}
function selectPart(number){adminPart=number;render()}
async function previewFile(){try{const file=$('file').files[0];if(!file)throw Error('Chọn file Word trước khi xem.');const data=new FormData();data.append('file',file);exam=await call('/Reading/PreviewFile',{method:'POST',body:data});render();message('Cấu trúc hợp lệ. Đang xem trước; chưa lưu SQL Server.')}catch(e){message(e.message,true)}}
async function saveQuestion(n){try{await call('/Reading/EditQuestion?id='+exam.id,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({number:n,text:$('stem-'+n).value,options:'ABCD'.split('').map(a=>$('opt-'+n+'-'+a).value),answer:$('answer-'+n).value,status:$('status-'+n).value})});message('Đã lưu câu '+n);await loadExamPreview(exam.id);$('q-'+n).open=true}catch(e){message(e.message,true)}}
async function saveDoc(id){try{let imageBase64=null;const file=$('img-'+id).files[0];if(file){if(file.size>8000000)throw Error('Ảnh quá 8 MB.');imageBase64=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result.split(',')[1]);r.onerror=reject;r.readAsDataURL(file)})}await call('/Reading/EditDocument?id='+exam.id,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,text:$('doc-'+id).value,imageBase64,removeImage:$('remove-'+id).checked})});message('Đã lưu tài liệu.');await loadExamPreview(exam.id)}catch(e){message(e.message,true)}}
$('upload').onsubmit=async ev=>{ev.preventDefault();const b=ev.target.querySelector('button');b.disabled=true;try{const data=new FormData();data.append('file',$('file').files[0]);const r=await call('/Reading/Import',{method:'POST',body:data});message('Import thành công.');await load();await loadExamPreview(r.id)}catch(e){message(e.message,true)}finally{b.disabled=false}};load();
</script></body></html>


