@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reading Studio · Admin & User</title>
<style>*{box-sizing:border-box}body{margin:0;background:#f6f7f4;color:#142d32;font-family:Segoe UI,Arial,sans-serif}header{height:70px;background:#142d32;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 24px;gap:12px}strong{font-size:20px}nav{display:flex;gap:8px}button{font:inherit;font-weight:600;border:1px solid #58716d;border-radius:10px;background:transparent;color:white;padding:11px 20px;cursor:pointer}button[aria-pressed=true]{background:#e7f0e8;color:#087f69;border-color:#e7f0e8}.view{border:0;width:100%;height:calc(100dvh - 70px);display:block}.view[hidden]{display:none}@@media(max-width:500px){header{padding:0 12px}strong{font-size:16px}button{padding:10px 14px}}</style></head>
<body><header><strong>Reading Studio</strong><nav aria-label="Chọn vai trò"><button id="user" aria-pressed="true" onclick="selectRole('user')">User · Làm bài</button><button id="admin" aria-pressed="false" onclick="selectRole('admin')">Admin · Quản lý đề</button></nav></header>
<iframe class="view" id="user-view" src="/app/index.html" title="User làm bài TOEIC"></iframe><iframe class="view" id="admin-view" title="Admin quản lý đề TOEIC" hidden></iframe>
<script>function selectRole(role){for(const name of ['user','admin']){document.getElementById(name).setAttribute('aria-pressed',String(role===name));document.getElementById(name+'-view').hidden=role!==name}const admin=document.getElementById('admin-view');if(role==='admin'&&!admin.getAttribute('src'))admin.src='/Reading';history.replaceState(null,'','#'+role)}if(location.hash==='#admin')selectRole('admin');</script></body></html>
