@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reading Studio · Admin & User</title>
<link rel="stylesheet" href="/css/reading-studio-v2.css"><style>.view{border:0;width:100%;height:calc(100dvh - 72px);display:block}.view[hidden]{display:none}.v2-area-switch button[aria-pressed=true]{background:white;color:var(--v2-green);box-shadow:0 2px 8px #142d3214}.v2-logo>span{font-weight:700}.v2-product-header{position:relative}@@media(max-width:700px){.v2-product-header{height:108px;grid-template-columns:1fr;justify-items:center;gap:8px;padding:10px}.view{height:calc(100dvh - 108px)}.v2-header-note{display:none}.v2-area-switch{justify-self:center}.v2-area-switch button{font-size:12px;width:auto;min-width:130px;padding:0 12px}}</style></head>
<body><header class="v2-product-header"><div class="v2-logo"><span>R</span><strong>Reading Studio</strong></div><nav class="v2-area-switch" aria-label="Chọn vai trò"><button id="user" aria-pressed="true" onclick="selectRole('user')">Người học · User</button><button id="admin" aria-pressed="false" onclick="selectRole('admin')">Quản lý đề · Admin</button></nav><span class="v2-header-note">TOEIC Reading · 100 câu · 75 phút</span></header>
<iframe class="view" id="user-view" src="/app/index.html" title="User làm bài TOEIC"></iframe><iframe class="view" id="admin-view" title="Admin quản lý đề TOEIC" hidden></iframe>
<script>function selectRole(role){for(const name of ['user','admin']){document.getElementById(name).setAttribute('aria-pressed',String(role===name));document.getElementById(name+'-view').hidden=role!==name}const admin=document.getElementById('admin-view');if(role==='admin'&&!admin.getAttribute('src'))admin.src='/Reading';history.replaceState(null,'','#'+role)}if(location.hash==='#admin')selectRole('admin');</script></body></html>
